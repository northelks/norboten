{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "norboten": {
      "source": {
        "source": "directory",
        "path": "."
      }
    }
  },
  "enabledPlugins": {
    "norboten-author@norboten": true
  },
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(/ansible/group_vars/all/vault.yml)",
      "Read(.vault_pass*)",
      "Read(vault-password*)",
      "Read(/terraform/terraform.tfvars)",
      "Read(*.tfstate)",
      "Read(*.tfstate.*)",
      "Read(*.pem)",
      "Read(*.key)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/after_edit.py\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
