# Copy to production.yml and put in the server's address from the netcup Customer Control Panel.
# Secrets live in group_vars/all/vault.yml, encrypted with ansible-vault — never here.
all:
  hosts:
    norboten:
      ansible_host: 203.0.113.10
      ansible_user: deploy
  vars:
    norboten_domain: norboten.org
    norboten_acme_email: ops@norboten.org
