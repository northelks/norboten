# Copy to .env (the server) or .env.local (make stack-up) and fill in. Never commit either.
NORBOTEN_DOMAIN=norboten.org
ACME_EMAIL=ops@norboten.org

# the API image: the deploy workflow sets API_TAG to the commit it built
API_IMAGE=ghcr.io/northelks/norboten-api
API_TAG=latest
API_WORKERS=2

# generate each with: openssl rand -base64 32
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# the MCP server's quiz state, shared by the API workers; empty is right with API_WORKERS=1 only
MCP_STATE_KEY=

# models: the server runs Ollama for the consultant and nothing hosted, one model loaded at a time
# in a 1 GB limit. The tutor and the post-mortem run on the learner's machine, not here.
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_MEMORY=1g

# a real session going live is announced on Telegram (a bot token, and the channel: @name or -100…)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT=
# donations (Stripe Checkout): the secret key, sk_live_… or sk_test_… to rehearse.
# Empty and the donate page says card donations are off on this deployment.
STRIPE_SECRET_KEY=
# signing in: a GitHub OAuth App (Settings → Developer settings → OAuth Apps), callback
# https://api.<domain>/auth/github/callback, Enable Device Flow ticked. REQUIRED on a server —
# GitHub is the only way in, so without it nobody can sign in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# optional: Discord linking and the weekly digest as a direct message. An application with a bot,
# OAuth2 redirect https://api.<domain>/auth/discord/callback, the bot in the Norboten server with
# Create Instant Invite and Send Messages. Empty bot token: no Discord and no digest.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# BACKUP_TARGET=sftp:backup@storage.example.org:/norboten   # optional off-box copy (restic)
# RESTIC_PASSWORD=
