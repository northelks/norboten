/* Norboten — dark ground, white text, green for headings and state. Restraint over nostalgia. */
Screen {
    background: #0b0f0d;
    color: #e8ece9;
}
Footer {
    background: #0f1512;
}
.title {
    color: #4ade80;
    text-style: bold;
    padding: 1 2 0 2;
    height: auto;
}
.subtitle {
    color: #8a948e;
    padding: 0 2 1 2;
    height: auto;
}
.h2 {
    height: auto;
    padding: 1 1 0 1;
}
.panel {
    border: round #1f3b2c;
    border-title-color: #4ade80;
    border-subtitle-color: #8a948e;
    background: #0f1512;
    padding: 0 1;
    height: auto;
}

/* ---- the main screen ---- */
#body {
    height: 1fr;
}
#content {
    width: 1fr;
    height: 100%;
    padding: 0 1;
}
#side {
    width: 42;
    height: 100%;
}
#side .panel {
    margin-bottom: 0;
}
#sessions {
    height: 1fr;
}
#sessions, #doctor, .bars, .strongest {
    text-wrap: nowrap;
    text-overflow: ellipsis;
}
#activity {
    height: 7;
    border: round #1f3b2c;
    border-title-color: #4ade80;
    background: #0f1512;
    scrollbar-size-vertical: 1;
}
OptionList {
    background: #0f1512;
}
OptionList > .option-list--option-highlighted {
    background: #173524;
    color: #ffffff;
}
DataTable {
    background: #0b0f0d;
    height: 1fr;
}
DataTable > .datatable--header {
    background: #0f1512;
    color: #4ade80;
    text-style: bold;
}
DataTable > .datatable--cursor {
    background: #173524;
    color: #ffffff;
}
Markdown {
    background: #0b0f0d;
}
VerticalScroll {
    scrollbar-color: #1f3b2c;
    scrollbar-color-hover: #15803d;
    scrollbar-color-active: #4ade80;
    scrollbar-background: #0b0f0d;
    scrollbar-size-vertical: 1;
}

/* ---- home ---- */
#home-logo {
    padding: 1 1 0 1;
    height: auto;
}
#home-tagline {
    padding: 1 1;
    height: auto;
}
#home-cards {
    height: auto;
}
.card {
    width: 1fr;
    height: 5;
    border: round #1f3b2c;
    background: #0f1512;
    padding: 0 2;
    margin-right: 1;
}
#home-next {
    height: auto;
    max-height: 16;
    border: round #1f3b2c;
}

/* ---- labs, theory, journals ---- */
#labs-table, #banks, #journals-table {
    width: 3fr;
}
#labs-preview, #journal-view {
    width: 2fr;
    border: round #1f3b2c;
    border-title-color: #4ade80;
    padding: 0 1;
}
#journal-view {
    width: 1fr;
}
#journals-table {
    width: 40;
}
#labs-meta {
    height: auto;
    padding-bottom: 1;
}
#bank-about {
    width: 2fr;
    height: 1fr;
}

/* ---- play ---- */
#play-left {
    width: 38;
}
#play-sources {
    height: 1fr;
    border: round #1f3b2c;
    border-title-color: #4ade80;
}
#play-commands {
    height: 1fr;
    border: round #1f3b2c;
    border-title-color: #4ade80;
    border-subtitle-color: #8a948e;
}
TermPlayer {
    width: 1fr;
    height: 100%;
    border: round #1f3b2c;
}
TermPlayer:focus-within {
    border: round #4ade80;
}
.player-bar {
    height: 1;
    background: #0f1512;
}
.player-bar Button {
    min-width: 0;
    width: auto;
    margin-right: 1;
    background: #173524;
    color: #e8ece9;
}
.player-status {
    width: 1fr;
    padding: 0 1;
}
.player-screen {
    height: 1fr;
    overflow: hidden hidden;
    text-wrap: nowrap;
    text-overflow: clip;
}
#play-sources, #play-commands, #home-next, #board-topics {
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* ---- ratings and profiles ---- */
#board-topics {
    width: 30;
    border: round #1f3b2c;
    border-title-color: #4ade80;
}
#board {
    width: 1fr;
}
.profile-head {
    padding: 1 1 0 1;
    height: auto;
}
ProfileView Heatmap {
    padding: 0 1;
}
ProfileView Heatmap:focus {
    background: #0f1512;
}
.profile-topics {
    height: auto;
}
.profile-topics > Vertical {
    height: auto;
    width: 1fr;
}
.bars, .strongest {
    height: auto;
    padding: 0 1;
}
.profile-topics > .strongest-box {
    width: 36;
}
ProfileView .attempts {
    height: 16;
}
#you-claim {
    height: auto;
    padding: 1;
    border: round #1f3b2c;
}
.form-row {
    height: auto;
    margin-top: 1;
}
#nick {
    width: 1fr;
}
#country {
    width: 22;
}
#you-country {
    margin: 0 0 1 0;
}
#you-country .form-label {
    width: auto;
    padding: 1 1 0 1;
}
#country-change {
    width: 14;
}

/* ---- system ---- */
#doctor-full, #about {
    height: auto;
    padding: 0 1;
}
#images {
    height: auto;
    max-height: 10;
}

/* ---- setup ---- */
#setup-body {
    height: 1fr;
}
#setup-list, #setup-message {
    height: auto;
    padding: 0 2;
}
#setup-bar {
    height: 1;
    margin: 1 2 0 2;
}

/* ---- a lab ---- */
#lab-body {
    height: 1fr;
}
#lab-main {
    width: 1fr;
}
#lab-side {
    width: 50;
}
#lab-keys {
    height: 1fr;
}
#lab-tabs {
    height: 1fr;
}
#checktable {
    height: auto;
}
#verdict {
    height: auto;
    padding: 1 1 0 1;
}
#lab-log {
    height: 8;
    border: round #1f3b2c;
    background: #0f1512;
}
#download {
    height: 1;
    padding: 0 2;
}
Tabs .underline--bar {
    color: #4ade80;
}
.hint-text {
    border: round #1f3b2c;
    padding: 1 2;
    margin: 1 0;
    background: #0f1512;
    height: auto;
}
#solutiontext {
    padding: 1 2;
}

/* ---- dialogs ---- */
ModalScreen {
    align: center middle;
    background: #0b0f0d 70%;
}
.dialog {
    width: 64;
    height: auto;
    max-height: 90%;
    border: round #4ade80;
    background: #0f1512;
    padding: 1 2;
}
.dialog.wide {
    width: 90;
}
.dialog.tall {
    height: 90%;
}
.dialog-detail {
    padding: 1 0;
    height: auto;
}
.dialog-buttons {
    height: auto;
    align: right middle;
    margin-top: 1;
}
.dialog-buttons Button {
    margin-left: 2;
}
/* sign in: the code GitHub issued, large enough to read across a room */
#signin-code {
    height: auto;
    padding: 1 0;
    text-style: bold;
}
#signin-remember {
    margin-top: 1;
    background: transparent;
    border: none;
}
#image-list {
    height: auto;
    max-height: 10;
    margin: 1 0;
}

/* ---- theory run ---- */
#quiz-bar {
    height: 3;
    padding: 1 2 0 2;
    color: #8a948e;
}
#question {
    padding: 1 2;
    height: auto;
}
#question-code {
    margin: 0 2;
    height: auto;
    border: round #1f3b2c;
    background: #0f1512;
}
#choices {
    margin: 1 2;
    height: auto;
    background: #0b0f0d;
    border: round #1f3b2c;
}
#feedback {
    margin: 0 2 1 2;
    padding: 1 2;
    height: auto;
    border: round #1f3b2c;
    background: #0f1512;
}
#feedback.right {
    border: round #4ade80;
}
#feedback.wrong {
    border: round #f87171;
}
ProgressBar Bar > .bar--bar {
    color: #4ade80;
}

/* the sections and the brand share the top line: sections on the left, [ norboten ] on the right */
#topline { height: 1; background: #0f1512; }
#topline > TopBar { width: auto; }
